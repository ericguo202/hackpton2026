# Frontend environment variables (Vite). Copy to `.env` and fill in.
# Only VITE_-prefixed vars are exposed to the client bundle.

# Backend API origin. Defaulted to http://localhost:8000 in lib/api.ts;
# override for a deployed backend.
VITE_API_URL=http://localhost:8000

# Clerk publishable key (public — safe to ship in the client bundle).
# main.tsx throws at boot if this is missing.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 measurement ID (optional). When unset, analytics is fully
# disabled (analyticsEnabled() is false and nothing loads). Consent is geo-gated:
# EU/EEA/UK + unknown = strict opt-in (nothing until Accept); US = full GA4 by
# default (opt-out); AU/NZ/SG = cookieless pings by default (opt-out). GPC always
# overrides. Region comes from the Vercel edge (frontend/middleware.ts) in prod.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Set to "true" to console.debug every gtag command in dev (optional).
VITE_GA_DEBUG=false

# Dev-only region override (optional). There is no Vercel edge under `vite dev`, so
# the ip_country cookie is absent and the region falls back to `strict`. Set this to
# exercise a bucket: `us` | `implied` | `strict`, or a 2-letter country code
# (e.g. `US`, `AU`, `GB`, `IN`). Leave unset in production.
VITE_GA_FORCE_REGION=
